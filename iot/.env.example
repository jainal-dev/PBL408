# IoT Device Configuration
# Environment variables for IoT device management and communication

# Serial Communication
IOT_PORT=/dev/ttyUSB0
IOT_BAUD_RATE=9600
IOT_DATA_BITS=8
IOT_PARITY=none
IOT_STOP_BITS=1

# Device Configuration
IOT_DEVICE_ID=default-device
IOT_DEVICE_TYPE=sensor
IOT_FIRMWARE_VERSION=1.0.0

# Communication Protocol
IOT_PROTOCOL=serial
IOT_BUFFER_SIZE=1024
IOT_TIMEOUT=5000

# Data Processing
IOT_DATA_FORMAT=json
IOT_DATA_SEPARATOR=,
IOT_DATA_VALIDATION=true

# Network Configuration (for ESP32/WiFi devices)
IOT_WIFI_SSID=your-wifi-ssid
IOT_WIFI_PASSWORD=your-wifi-password
IOT_MQTT_BROKER=broker.hivemq.com
IOT_MQTT_PORT=1883
IOT_MQTT_TOPIC=pbl409/sensors

# Sensor Configuration
IOT_SENSOR_UPDATE_INTERVAL=1000
IOT_SENSOR_CALIBRATION_OFFSET=0.0
IOT_SENSOR_CALIBRATION_SCALE=1.0

# Logging
IOT_LOG_LEVEL=info
IOT_LOG_FILE=iot/logs/device.log
IOT_LOG_MAX_SIZE=10485760

# Backend Integration
IOT_API_URL=http://localhost:5000/api/iot
IOT_API_KEY=your-iot-api-key
IOT_SEND_INTERVAL=5000

# Development
IOT_DEBUG_MODE=true
IOT_SIMULATION_MODE=false
