# Web Application Environment Variables
# These variables are exposed to the client-side code (prefixed with VITE_)

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000

# Application Configuration
VITE_APP_NAME=PBL409 Production System
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Authentication
VITE_AUTH_REDIRECT_URL=/dashboard
VITE_LOGIN_URL=/login

# IoT Configuration
VITE_IOT_UPDATE_INTERVAL=5000
VITE_IOT_CHART_POINTS=50

# UI Configuration
VITE_THEME=default
VITE_LANGUAGE=en

# Development
VITE_DEV_TOOLS=true
VITE_MOCK_API=false

# Analytics (optional)
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_PWA_CACHE_NAME=pbl409-v1
